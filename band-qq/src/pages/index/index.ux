<template>
  <div class="page">
    <div class="top-row">
      <image class="btn" src="../../common/ui/more.png" @click="goSettings"></image>
    </div>
    <scroll class="list" scroll-y="true" show="{{conversations.length}}">
      <div class="card item" for="{{item in conversations}}" @click="openChatItem(item)">
        <div class="avatar {{item.type === 'group' ? 'avatar-group' : 'avatar-private'}}">
          <text class="avatar-text">{{firstName(item)}}</text>
        </div>
        <div class="body">
          <text class="item-name">{{shortName(item.name)}}</text>
          <text class="item-tag" if="{{item.is_temporary}}">临时</text>
        </div>
      </div>
    </scroll>
    <div class="empty-wrap" show="{{!conversations.length}}">
      <image class="empty-icon" src="../../common/ui/empty_icon.png"></image>
      <text class="empty-text">{{conversations.length === 0 ? '请在手机端添加联系人' : '暂无会话'}}</text>
    </div>
    <div class="status-bar">
      <text class="status-text">{{statusText}}</text>
    </div>
  </div>
</template>

<style>
  .page { flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .list { height: 340px; padding-top: 6px; flex-direction: column; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 16px; background-color: #262626; }
  .item { height: 72px; width: 100%; flex-direction: row; align-items: center; margin: 4px 8px; padding: 0 10px; }
  .avatar { width: 44px; height: 44px; border-radius: 22px; background-color: #1f1f1f; margin-right: 10px; justify-content: center; align-items: center; }
  .avatar-private { background-color: #1f1f1f; }
  .avatar-group { background-color: #2a3b4c; border-radius: 10px; }
  .avatar-text { font-size: 20px; color: #ffffff; }
  .body { flex-direction: row; align-items: center; flex: 1; }
  .item-name { font-size: 20px; color: #ffffff; }
  .item-tag { font-size: 12px; color: #ffb800; border-width: 1px; border-color: #ffb800; border-radius: 6px; padding: 0 4px; margin-left: 6px; }
  .empty-wrap { height: 180px; flex-direction: column; justify-content: center; align-items: center; }
  .empty-icon { width: 78px; height: 78px; object-fit: contain; }
  .empty-text { margin-top: 12px; font-size: 20px; color: rgba(255, 255, 255, 0.5); }
  .status-bar { height: 60px; justify-content: center; align-items: center; }
  .status-text { font-size: 20px; color: rgba(255, 255, 255, 0.6); }
</style>

<script>
  import router from '@system.router'
  import protocol from '../../common/protocol'

  export default {
    private: {
      statusText: '未连接',
      conversations: []
    },
    onShow() {
      console.log('[BANDQQ] v9 index onShow, protocol=', typeof protocol)
      this.refreshStatus()
      this.pullConnectState()
      this.loadConversations()
      this.loadVisibleContacts()
    },
    onInit() {
      const def = this.$app.$def
      this._handlers = {
        conversations: () => this.refreshConversations(),
        visible_contacts: () => this.refreshConversations(),
        message: () => this.refreshConversations(),
        state: () => this.refreshStatus()
      }
      def.on('conversations', this._handlers.conversations)
      def.on('visible_contacts', this._handlers.visible_contacts)
      def.on('message', this._handlers.message)
      def.on('state', this._handlers.state)
    },
    onDestroy() {
      const def = this.$app.$def
      if (this._handlers) {
        def.off('conversations', this._handlers.conversations)
        def.off('visible_contacts', this._handlers.visible_contacts)
        def.off('message', this._handlers.message)
        def.off('state', this._handlers.state)
        this._handlers = null
      }
    },
    async pullConnectState() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getConnectState())
      } catch (e) {
        console.error('pull connect state failed', e)
      }
    },
    async refreshStatus() {
      const store = this.$app.$def.store
      const s = store.getConnectState()
      this.statusText = s && s.band ? '已连接' : '未连接'
    },
async loadConversations() {
      const store = this.$app.$def.store
      this.conversations = await store.getConversations()
      console.log('[index] loadConversations ->', this.conversations.length, 'conv, visible=', store.getVisibleContacts ? (await store.getVisibleContacts()).length : '?')
      try {
        const dump = this.conversations.slice(0, 20).map((c) => (c.id === '' || c.id === undefined || c.id === null) ? '[' + c.name + ']->EMPTY' : c.id).join('|')
        console.log('[index] conv dump ->', dump)
      } catch (e) {}
      const api = this.$app.$def.api
      api.send({ type: 'get_conversations', seq: Date.now() % 100000 })
    },
    async refreshConversations() {
      const store = this.$app.$def.store
      this.conversations = await store.getConversations()
      console.log('[index] refreshConversations ->', this.conversations.length, 'conv')
      try {
        const dump = this.conversations.slice(0, 20).map((c) => (c.id === '' || c.id === undefined || c.id === null) ? '[' + c.name + ']EMPTY' : c.id).join('|')
        console.log('[index] refresh dump ->', dump)
      } catch (e) {}
    },
openChatItem(item) {
      if (!item) {
        console.log('[index] openChatItem empty item')
        return
      }
      console.log('[index] openChatItem ->', item.id, item.name)
      if (!item.id) return
      const store = this.$app.$def.store
      store.setLastTarget({ targetId: item.id, name: item.name })
      router.push({
        uri: '/chat?targetId=' + encodeURIComponent(item.id) + '&name=' + encodeURIComponent(item.name || ''),
        params: { targetId: item.id, name: item.name }
      })
    },
    firstName(item) {
      if (!item || typeof item.name !== 'string') return ''
      return item.name.charAt(0) || ''
    },
    shortName(name) {
      if (!name || typeof name !== 'string') return name || ''
      if (name.length <= 9) return name
      return name.slice(0, 9) + '…'
    },
    async loadVisibleContacts() {
      const api = this.$app.$def.api
      try {
        await api.send(protocol.getVisibleContacts())
      } catch (e) {
        console.error('pull visible contacts failed', e)
      }
    },
    goSettings() {
      router.push({ uri: '/settings' })
    }
  }
</script>
