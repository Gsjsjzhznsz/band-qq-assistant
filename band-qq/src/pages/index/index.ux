<template>
  <div class="page">
    <div class="title-bar">
      <text class="title">{{statusText}} · {{appName}}</text>
      <image class="btn-more" src="../../common/ui/more.png" onclick="goSettings"></image>
    </div>
    <list class="list" if="{{conversations.length}}">
      <list-item type="conv" for="{{(idx, item) in conversations}}" onclick="openChat(idx)">
        <div class="card item">
          <div class="avatar">
            <text class="avatar-text">{{$item.name.charAt(0)}}</text>
          </div>
          <div class="item-body">
            <text class="item-name">{{$item.name}}</text>
            <text class="item-sub">{{$item.last_msg}}</text>
          </div>
        </div>
      </list-item>
    </list>
    <div class="empty-wrap" if="{{!conversations.length}}">
      <image class="empty-icon" src="../../common/ui/empty_icon.png"></image>
      <text class="empty-text">暂无会话</text>
    </div>
  </div>
</template>

<style>
  .page { width: 192px; height: 490px; flex-direction: column; background-color: #000000; }
  .title-bar { width: 192px; height: 78px; flex-direction: row; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .title { font-size: 20px; color: #ffffff; line-height: 78px; text-align: center; }
  .btn-more { width: 102px; height: 72px; position: absolute; right: 0px; top: 6px; object-fit: contain; }
  .list { width: 192px; height: 406px; padding-top: 4px; }
  .card { border-width: 1px; border-color: rgba(255, 255, 255, 0.06); border-radius: 16px; background-color: #262626; }
  .item { width: 176px; height: 56px; flex-direction: row; align-items: center; margin: 4px 8px; }
  .avatar { width: 36px; height: 36px; border-radius: 18px; background-color: #1f1f1f; margin-right: 10px; margin-left: 8px; justify-content: center; align-items: center; }
  .avatar-text { font-size: 18px; color: #ffffff; }
  .item-body { flex: 1; flex-direction: column; }
  .item-name { font-size: 18px; color: #ffffff; }
  .item-sub { font-size: 14px; color: rgba(255, 255, 255, 0.6); max-lines: 1; }
  .empty-wrap { width: 192px; height: 406px; flex-direction: column; justify-content: center; align-items: center; }
  .empty-icon { width: 80px; height: 80px; object-fit: contain; }
  .empty-text { margin-top: 12px; font-size: 18px; color: rgba(255, 255, 255, 0.5); }
</style>

<script>
  import router from '@system.router'

  export default {
    private: {
      appName: 'QQ助手',
      statusText: '未连接',
      conversations: []
    },
    onShow() {
      this.refreshStatus()
      this.loadConversations()
    },
    onInit() {
      this.$app.$def.on('conversations', () => this.loadConversations())
    },
    onDestroy() {
      this.$app.$def.off('conversations')
    },
    async refreshStatus() {
      const api = this.$app.$def.api
      try {
        const ok = await api.connectStatus()
        this.statusText = ok ? '已连接' : '未连接'
      } catch (e) {
        this.statusText = '未连接'
      }
    },
    async loadConversations() {
      const store = this.$app.$def.store
      const api = this.$app.$def.api
      this.conversations = await store.getConversations()
      api.send({ type: 'get_conversations', seq: Date.now() % 100000 })
    },
    openChat(idx) {
      const conv = this.conversations[idx]
      router.push({
        uri: '/chat',
        params: { targetId: conv.id, name: conv.name }
      })
    },
    goSettings() {
      router.push({ uri: '/settings' })
    }
  }
</script>
