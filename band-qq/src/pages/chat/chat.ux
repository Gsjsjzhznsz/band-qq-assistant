<template>
  <div class="page">
    <div class="top-row">
      <image class="btn" src="../../common/ui/back.png" onclick="goBack"></image>
    </div>
    <div class="title-bar">
      <text class="page-title">{{name}}</text>
    </div>
    <scroll class="msg-area" scroll-y="true">
      <div class="msg-item {{msg.is_self ? 'self' : 'other'}}" for="{{(idx, msg) in messages}}">
        <div class="msg-col {{msg.is_self ? 'col-self' : 'col-other'}}">
          <text class="msg-name" if="{{msg.message_type === 'group'}}">{{msg.is_self ? '我' : msg.sender_name}}</text>
          <text class="bubble {{msg.is_self ? 'bubble-self' : 'bubble-other'}}">{{msg.content}}</text>
        </div>
      </div>
    </scroll>
    <div class="input-bar" onclick="openCompose">
      <text class="input-preview">点击输入消息</text>
      <image class="btn" src="../../common/ui/kb_show.png"></image>
    </div>
  </div>
</template>

<style>
  .page { flex-direction: column; background-color: #000000; }
  .top-row { height: 78px; align-items: flex-start; justify-content: center; padding-top: 6px; }
  .btn { width: 102px; height: 72px; }
  .title-bar { height: 40px; align-items: center; justify-content: center; }
  .page-title { font-size: 24px; color: #ffffff; }
  .msg-area { height: 160px; }
  .msg-item { width: 192px; padding: 4px 8px; flex-direction: row; }
  .self { justify-content: flex-end; }
  .other { justify-content: flex-start; }
  .msg-col { flex-direction: column; }
  .col-self { align-items: flex-end; }
  .col-other { align-items: flex-start; }
  .msg-name { font-size: 14px; color: rgba(255, 255, 255, 0.55); margin-bottom: 2px; }
  .bubble { max-width: 140px; padding: 8px 10px; border-radius: 10px; font-size: 18px; }
  .bubble-self { background-color: #07c160; color: #ffffff; }
  .bubble-other { background-color: #1f1f1f; color: #ffffff; }
  .input-bar { height: 84px; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 8px; border-top: 1px solid #222222; }
  .input-preview { flex: 1; font-size: 20px; color: #666666; }
</style>

<script>
  import router from '@system.router'

  export default {
    protected: {
      targetId: '',
      name: '',
      messages: []
    },
    onInit(params) {
      this.targetId = (params && params.targetId) || ''
      this.name = (params && params.name) || '聊天'
      this.$app.$def.on('message', () => this.loadMessages())
      this.$app.$def.on('history', (msg) => {
        if (msg.target_id === this.targetId) this.loadMessages()
      })
      this.$app.$def.on('cleared', () => this.loadMessages())
      this.requestHistory()
      this.loadMessages()
    },
    onDestroy() {
      this.$app.$def.off('message')
      this.$app.$def.off('history')
      this.$app.$def.off('cleared')
    },
    onShow() {
      this.loadMessages()
    },
    goBack() {
      router.back()
    },
    openCompose() {
      router.push({
        uri: '/compose',
        params: { targetId: this.targetId, name: this.name }
      })
    },
    requestHistory() {
      const protocol = this.$app.$def.protocol
      const api = this.$app.$def.api
      api.send(protocol.getHistory(this.targetId, 50))
    },
    async loadMessages() {
      const store = this.$app.$def.store
      this.messages = await store.getMessages(this.targetId)
    }
  }
</script>